{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "sdk-51"
      },
      "ios": {
        "image": "sdk-51"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "sdk-51"
      },
      "ios": {
        "image": "sdk-51"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "image": "sdk-51",
        "simulator": true
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-51"
      },
      "ios": {
        "image": "sdk-51"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
