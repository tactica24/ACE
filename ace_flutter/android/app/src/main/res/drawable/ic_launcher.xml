<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#060913" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:top="10dp" android:right="10dp" android:bottom="10dp" android:left="10dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#D7B36A"
                android:startColor="#F4E0A6" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:top="21dp" android:right="21dp" android:bottom="21dp" android:left="21dp">
        <shape android:shape="rectangle">
            <solid android:color="#060913" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:top="28dp" android:right="28dp" android:bottom="28dp" android:left="28dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#D7B36A"
                android:startColor="#F4E0A6" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
