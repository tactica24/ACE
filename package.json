{
  "name": "ace-studio",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "dev": "npm run db:push && next dev",
    "postinstall": "node scripts/run-prisma.mjs generate",
    "build": "npm run deploy:prepare:production && npm run prisma:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts && tsx tests/run-tests.ts",
    "test:coverage": "c8 --check-coverage --lines 60 --functions 60 --branches 50 --statements 60 tsx --test tests/**/*.test.ts",
    "test:legacy": "tsx tests/run-tests.ts",
    "prisma:generate": "node scripts/run-prisma.mjs generate",
    "prisma:migrate": "node scripts/run-prisma.mjs migrate dev",
    "db:push": "node scripts/run-prisma.mjs db push --skip-generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:bootstrap": "npm run db:push && npm run db:seed",
    "deploy:prepare:production": "node scripts/deploy-prepare-production.mjs",
    "db:repair:known": "node scripts/repair-known-production-migrations.mjs",
    "env:sync:mobile": "node scripts/sync-mobile-firebase-env.mjs",
    "smoke:relay": "node scripts/smoke-relay.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "launch:check": "node scripts/launch-checklist.mjs",
    "db:migrate:deploy": "node scripts/run-prisma.mjs migrate deploy",
    "cleanup:storage": "tsx scripts/cleanup-storage.ts",
    "storage:backfill:legacy": "tsx scripts/backfill-legacy-media-to-bunny.ts",
    "gateway:upload": "node scripts/bunny-upload-gateway.mjs",
    "build:android-apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "sync:github-android-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-github-android-secrets.ps1",
    "sync:vercel-android-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-vercel-android-secrets.ps1",
    "db:post-commit": "npm run db:push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.821.0",
    "@aws-sdk/s3-request-presigner": "^3.821.0",
    "@firebase/auth": "1.10.8",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "es-abstract": "1.24.2",
    "fflate": "^0.8.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "hls.js": "^1.5.17",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.263.1",
    "next": "^15.5.26",
    "react": "18.2.0",
    "react-dom": "19.3.0",
    "stripe": "^16.2.0",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^19.3.0",
    "c8": "^10.1.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.26",
    "prisma": "5.22.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "brace-expansion": "^5.0.12",
    "esbuild": "^0.28.2",
    "form-data": "^4.0.6",
    "glob": "^13.0.6",
    "joi": "^18.2.9",
    "js-yaml": "^5.4.2",
    "nanoid": "^6.0.1",
    "postcss": "^8.5.28",
    "protobufjs": "^8.8.0",
    "qs": "^6.16.0",
    "socket.io-parser": "^4.2.7",
    "undici": "^8.11.2",
    "uuid": "^14.0.2",
    "websocket-driver": "^0.7.5",
    "ws": "^8.21.3"
  }
}
