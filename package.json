{
  "name": "ace-studio",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node scripts/run-prisma.mjs generate",
    "prisma:migrate": "node scripts/run-prisma.mjs migrate dev",
    "db:push": "node scripts/run-prisma.mjs db push --skip-generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:bootstrap": "npm run db:push && npm run db:seed",
    "deploy:prepare:production": "npm run db:repair:known && npm run db:migrate:deploy",
    "db:repair:known": "node scripts/repair-known-production-migrations.mjs",
    "env:sync:mobile": "node scripts/sync-mobile-firebase-env.mjs",
    "smoke:relay": "node scripts/smoke-relay.mjs",
    "launch:check": "node scripts/launch-checklist.mjs",
    "db:migrate:deploy": "node scripts/run-prisma.mjs migrate deploy",
    "transcode:hls": "node scripts/transcode-hls.mjs",
    "publish:hls": "node scripts/publish-hls.mjs",
    "transcode:dash": "node scripts/transcode-dash.mjs",
    "publish:dash": "node scripts/publish-dash.mjs",
    "cleanup:storage": "tsx scripts/cleanup-storage.ts",
    "build:android-apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "prebuild": "npm run prisma:generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@firebase/auth": "1.10.8",
    "@prisma/client": "^5.16.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "es-abstract": "1.24.2",
    "firebase": "^11.6.1",
    "firebase-admin": "^13.4.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.263.1",
    "next": "14.2.35",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "stripe": "^16.2.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.8",
    "artillery": "^2.0.30",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "prisma": "^5.16.1",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5"
  }
}
