# Neon PostgreSQL
# DATABASE_URL should use the pooled Neon connection string (`-pooler` hostname).
DATABASE_URL="postgresql://USER:PASSWORD@EP-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# DIRECT_URL is optional but recommended for migrations.
# If it is set, the repo scripts will use it for Prisma migrate commands.
# If it is omitted, migrations fall back to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@EP-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# App API
API_BASE_URL="https://your-production-domain.com"

# Stream signing
ACE_STREAM_SIGNING_SECRET="replace-with-a-long-random-secret"

# Firebase Admin
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_KEY\\n-----END PRIVATE KEY-----\\n"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"

# Firebase Web
NEXT_PUBLIC_FIREBASE_API_KEY="replace-with-your-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Payments
PAYSTACK_SECRET_KEY="sk_live_xxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxx"
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Bunny Storage
BUNNY_STORAGE_API_KEY="replace-with-bunny-storage-password"
BUNNY_STORAGE_ZONE="ace-studio"
BUNNY_STORAGE_ENDPOINT="https://storage.bunnycdn.com"
BUNNY_STORAGE_S3_ENDPOINT="https://your-region-s3.storage.bunnycdn.com"
BUNNY_STREAM_LIBRARY_ID="replace-with-bunny-stream-library-id"
BUNNY_STREAM_API_KEY="replace-with-bunny-stream-api-key"
BUNNY_STREAM_READONLY_API_KEY="replace-with-bunny-stream-readonly-api-key"
BUNNY_STREAM_PULL_ZONE="replace-with-bunny-stream-pull-zone"
BUNNY_STREAM_PLAYER_HOST="player.mediadelivery.net"
BUNNY_CDN_HOSTNAME="cdn.acestudio.ng"
BUNNY_TOKEN_KEY="replace-with-bunny-token-auth-key"

# App URLs
ACE_APP_BASE_URL="https://your-production-domain.com"
# Optional fallback only when Bunny S3 direct uploads are unavailable.
ACE_UPLOAD_PROXY_BASE_URL=""

# Native Android APK download
# Preferred: set ACE_ANDROID_APK_URL to a public storage/CDN APK URL.
# Alternative: set ACE_ANDROID_APK_STORAGE_KEY and let the app create a short-lived Bunny CDN download link.
# Local fallback: add public/downloads/ace-studio-android.apk.
ACE_ANDROID_APK_URL=""
ACE_ANDROID_APK_STORAGE_KEY="downloads/ace-studio-android.apk"

# Optional release signing for `scripts/build-android-apk.ps1`.
# Without these, Flutter can still build an APK, but it will use debug signing.
ACE_ANDROID_KEYSTORE_PATH=""
ACE_ANDROID_KEYSTORE_PASSWORD=""
ACE_ANDROID_KEY_ALIAS=""
ACE_ANDROID_KEY_PASSWORD=""

# Relay / metrics
ACE_NODE_NAME="ace-app-origin-01"
ACE_NODE_REGION="NG"
ACE_NODE_LAGOS_URL=""
ACE_NODE_ABUJA_URL=""
ACE_NODE_JHB_URL=""
ACE_GRAFANA_URL=""

# Pricing / bundles
ACE_USD_NGN_RATE="1600"
ACE_GBP_NGN_RATE="2000"
ACE_CAD_NGN_RATE="1200"
ACE_FAMILY_PASS_CREDITS="50"
