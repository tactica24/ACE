name = "ace-stream"
main = "src/worker.js"
compatibility_date = "2026-05-05"

# Route this Worker from Cloudflare DNS after stream.acestudio.ng is proxied.
routes = [
  { pattern = "stream.acestudio.ng/*", zone_name = "acestudio.ng" }
]

[[r2_buckets]]
binding = "HLS_BUCKET"
bucket_name = "ace-hls"

[vars]
# Use your production app origin, or "*" while testing.
ALLOWED_ORIGIN = "https://acestudio.ng"

# Set this as a secret, not here:
# wrangler secret put ACE_STREAM_SIGNING_SECRET
