# Database
DATABASE_URL="postgresql://ace:ace@localhost:5432/ace?schema=public"
DIRECT_URL="postgresql://ace:ace@localhost:5432/ace?schema=public"

# App API
API_BASE_URL="http://localhost:3000"

# Stream signing
ACE_STREAM_SIGNING_SECRET="replace-with-strong-secret"

# Firebase Admin
FIREBASE_PROJECT_ID="replace-with-your-project-id"
FIREBASE_CLIENT_EMAIL="replace-with-your-client-email"
FIREBASE_PRIVATE_KEY="replace-with-your-private-key"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"

# Firebase Web
NEXT_PUBLIC_FIREBASE_API_KEY="replace-with-your-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Paystack
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# Stripe (Diaspora)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Bunny Storage
BUNNY_STORAGE_API_KEY="replace-with-bunny-storage-password"
BUNNY_STORAGE_ZONE="ace-studio"
BUNNY_STORAGE_ENDPOINT="https://storage.bunnycdn.com"
BUNNY_STORAGE_S3_ENDPOINT="https://your-region-s3.storage.bunnycdn.com"
BUNNY_CDN_HOSTNAME="cdn.acestudio.ng"
BUNNY_TOKEN_KEY="replace-with-bunny-token-auth-key"

# Contabo HLS worker
CONTABO_TRANSCODE_API_URL="https://transcode.example.com"
CONTABO_PIPELINE_SECRET="replace-with-random-shared-secret"

# Storage
ACE_STORAGE_DIR="./storage"

# Node identity
ACE_NODE_NAME="lagos-relay-01"
ACE_NODE_REGION="NG"

# Relay routing
ACE_NODE_LAGOS_URL="https://lagos.ace.stream"
ACE_NODE_ABUJA_URL="https://abuja.ace.stream"
ACE_NODE_JHB_URL="https://jhb.ace.stream"
ACE_SMOKE_TARGETS="http://localhost:3000,http://localhost:8081,http://localhost:8082"

# Optional MP4 normalization hosts use local ffmpeg defaults from lib/video-processing.ts.

# FX rates for reporting (NGN per 1 unit)
ACE_USD_NGN_RATE="1600"
ACE_GBP_NGN_RATE="2000"
ACE_CAD_NGN_RATE="1200"

# Family pass credits (wallet credits)
ACE_FAMILY_PASS_CREDITS="50"

# Grafana
ACE_GRAFANA_URL="http://localhost:3001/d/ace-studio-ops"

# App base URL
ACE_APP_BASE_URL="http://localhost:3000"
# Optional in local dev, recommended in production to avoid large upload 413 errors on the app host.
# Example: https://upload.your-production-domain.com
ACE_UPLOAD_PROXY_BASE_URL=""

# Native Android APK download
# Preferred: set ACE_ANDROID_APK_URL to a public storage/CDN APK URL.
# Alternative: set ACE_ANDROID_APK_STORAGE_KEY and let the app create a short-lived Bunny CDN download link.
# Local fallback: add public/downloads/ace-studio-android.apk.
ACE_ANDROID_APK_URL=""
ACE_ANDROID_APK_STORAGE_KEY="downloads/ace-studio-android.apk"

# Optional release signing for `scripts/build-android-apk.ps1`.
# Without these, Flutter can still build an APK, but it will use debug signing.
ACE_ANDROID_KEYSTORE_PATH=""
ACE_ANDROID_KEYSTORE_PASSWORD=""
ACE_ANDROID_KEY_ALIAS=""
ACE_ANDROID_KEY_PASSWORD=""

# Mobile env sync
# Run `npm run env:sync:mobile` after updating the Firebase NEXT_PUBLIC_* values above.
